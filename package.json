{
  "name": "chennai-metro-3d",
  "version": "0.1.0",
  "private": true,
  "description": "Chennai Metro 3D — an interactive real-time 3D ride along Chennai Metro Line 4.",
  "scripts": {
    "predev": "node scripts/build-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-worker.mjs",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/simulation/*.test.ts src/three/*.test.ts src/three/world/*.test.ts src/lib/*.test.ts",
    "osm:fetch": "node scripts/osm/fetch.mjs",
    "osm:bake": "node scripts/osm/bake-network.mjs",
    "osm:tiles": "node scripts/osm/bake-tiles.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "geist": "^1.7.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
